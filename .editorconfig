root = true

[*]
charset = utf-8
end_of_line = crlf
indent_size = 2
indent_style = tab
insert_final_newline = false
max_line_length = 120
tab_width = 2
trim_trailing_whitespace = true

[{*.c,*.c++,*.c++m,*.cc,*.ccm,*.cp,*.cpp,*.cppm,*.cu,*.cxx,*.cxxm,*.i,*.ii,*.ixx,*.m,*.mm,*.mxx,*.usf}]
indent_style = space

[{*.markdown,*.md}]
indent_style = space


[{CMakeLists.txt,*.cmake}]
indent_style = space
indent_size = 4